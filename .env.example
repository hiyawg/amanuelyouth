# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only. Never expose this one to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string. Signs student and check-in tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDENT_TOKEN_SECRET=change-me

# Your church's time zone, so "today" flips at your midnight.
NEXT_PUBLIC_CHURCH_TIMEZONE=America/New_York

# Shown on badges and the parent page.
NEXT_PUBLIC_CHURCH_NAME=Kids & Youth Discipleship
